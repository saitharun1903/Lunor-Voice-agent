# ==========================================
# LUNO PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# OmniDimension Voice Agent Integration (Server-Side Only)
OMNIDIM_API_KEY=your_omnidim_api_key_here
OMNIDIM_AGENT_ID=246585

# Application URL
NEXT_PUBLIC_BASE_URL=https://lunor.co.in

# Session & Admin Secret (Optional for signing)
ADMIN_SECRET=generate_a_random_32_character_secret_here

# Google Sheets Lead Forwarding Webhook URL (Optional, can also be set in Admin Dashboard)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
